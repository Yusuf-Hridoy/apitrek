# .env.example
# Add at least one provider key to enable AI generation.
MISTRAL_API_KEY=
GROQ_API_KEY=
GITHUB_MODELS_API_KEY=

# Optional: SQLite location for session history
# DATABASE_PATH=data/api_sentinel.db

# Optional: per-provider request timeout (seconds)
# LLM_TIMEOUT_SECONDS=30

# Optional: rate limits (per client IP). Format "<n>/<period>;<n>/<period>".
# RATE_LIMIT_DEFAULT=60/hour;300/day
# RATE_LIMIT_GENERATE=10/minute;100/day
# RATE_LIMIT_SECURITY=5/minute;40/day
# RATE_LIMIT_EXECUTE=15/minute;200/day
# RATE_LIMIT_EXECUTE_SINGLE=30/minute;300/day
